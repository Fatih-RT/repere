# Copy to infra/.env and fill in.

# Cloudflare Zero Trust → Networks → Tunnels → create a tunnel of type
# "Docker", pick the token it gives you (not the tunnel ID, not the
# certificate — the long token starting with "ey..."). Route its public
# hostname (revise.fatih-kilic.fr) to service http://pocketbase:8090.
CLOUDFLARE_TUNNEL_TOKEN=

# Only needed if you want to pin a different PocketBase release than the
# one baked into the Dockerfile.
# PB_VERSION=0.39.11
